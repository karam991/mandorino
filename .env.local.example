# Mandorino — Beispiel für lokale Umgebungsvariablen.
# Kopieren Sie diese Datei zu `.env.local` und tragen Sie Ihre Werte ein.
# Alle Variablen sind optional — ohne Supabase läuft die App im Demo-Modus
# (Template-Fallback, kein E-Mail-Versand, localStorage; Team-Login nur mit
# NEXT_PUBLIC_DEMO_MODE=1, siehe unten).

# ============================================================================
# KI-Zusammenfassung via Mistral (EU-Anbieter) — strikt deskriptiv, keine rechtliche Bewertung
# ============================================================================
MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-small-latest

# ============================================================================
# Öffentliche URL der Mandorino-Instanz — wird in Notification-Links benutzt
# ============================================================================
# MANDORINO_PUBLIC_URL=https://kanzlei-beispiel.mandorino.app

# ============================================================================
# E-Mail-Versand (SMTP) — Outlook / Gmail / eigener Mailserver
# ============================================================================
# Outlook  → smtp.office365.com:587 (SMTP_SECURE=false, STARTTLS)
# Gmail    → smtp.gmail.com:587 (App-Password, nicht das normale Passwort!)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=leads@kanzlei-beispiel.de
# SMTP_PASS=********
# SMTP_FROM="Kanzlei Beispiel <leads@kanzlei-beispiel.de>"

# ============================================================================
# Slack / Teams / generischer Webhook (in tenant.config.ts referenziert)
# ============================================================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXXXXX
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# GENERIC_WEBHOOK_URL=https://n8n.kanzlei.de/webhook/lead
# WEBHOOK_TOKEN=optional-shared-secret

# ============================================================================
# Supabase (Persistenz + Auth)
# ============================================================================
# Im Supabase-Projekt: Settings → API
#
# Server-Key (Service-Role, voller Zugriff — NIE im Client benutzen!):
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
#
# Browser-Keys für Supabase Auth (sicher exponierbar — RLS schützt die Daten):
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
#
# Mit gesetzten NEXT_PUBLIC_-Vars läuft das Team-Login über Supabase Auth
# (Cookie-Session, serverseitig per middleware.ts geschützt). Wer sich einloggen
# darf, steht in der Tabelle `tenant_team` (siehe supabase/schema.sql).

# =============================================================================
# Demo-Modus — NUR für Sales-Demos mit Fake-Daten, OHNE Supabase
# =============================================================================
# Ohne Supabase UND ohne dieses Flag ist /team/* gesperrt (fail closed).
# Alle Einträge aus TENANT.team melden sich mit dem gemeinsamen Passwort an.
# Das Passwort ist bewusst öffentlich (NEXT_PUBLIC_) — niemals mit echten Daten nutzen.
# NEXT_PUBLIC_DEMO_MODE=1
# NEXT_PUBLIC_DEMO_PASSWORD=

# =============================================================================
# Sicherheit (in Produktion setzen)
# =============================================================================
# Signiert die KI-Zusammenfassung, damit /api/leads sie dem Server zuordnen kann.
# Ohne Secret werden Client-Zusammenfassungen verworfen (Template-Zusammenfassung).
# Erzeugen:  openssl rand -base64 32
# MANDORINO_SIGNING_SECRET=
#
# Welche Kanzlei-Domains dürfen /embed und /chat per iframe einbinden?
# Komma-getrennte Origins. Nicht gesetzt = jede Seite (nur für Demo/Entwicklung!).
# EMBED_ALLOWED_ORIGINS=https://www.kanzlei.de,https://kanzlei.de
